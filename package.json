{
    "name": "maplibre-image-plugins",
    "version": "0.0.0",
    "description": "Animated style image plugins for MapLibre GL JS",
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "test": "npm run test-tsc && npm run test-eslint && npm run test-prettier",
        "test-tsc": "tsc --noEmit",
        "test-eslint": "eslint .",
        "test-prettier": "prettier --check .",
        "fix": "prettier --write . && eslint --fix ."
    },
    "peerDependencies": {
        "maplibre-gl": ">=6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.34.0",
        "maplibre-gl": "file:../maplibre-gl-js",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.41.0"
    }
}
